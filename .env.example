# ---------------------------
# Environment Variables Template
# Copy this file to .env and fill in your actual values.
# ---------------------------

# OpenAI or MCP-compatible API key
OPENAI_API_KEY=your_openai_key_here

# LLM model (GPT-4o-mini is safe + cheap)
LLM_MODEL=gpt-4o-mini

# Optional: HuggingFace or custom model endpoints
HF_API_KEY=
CUSTOM_LLM_ENDPOINT=

# Path to CNN model weights
MODEL_PATH=models/emotion_cnn.pth

# API settings
HOST=0.0.0.0
PORT=8000

# Log level
LOG_LEVEL=INFO

# Optional Pinecone psychology-context retrieval
EMOTION_CONTEXT_BACKEND=local
PINECONE_API_KEY=
PINECONE_INDEX_NAME=emotion-context
PINECONE_NAMESPACE=emotion-context
EMBEDDING_MODEL=text-embedding-3-small
